FROM maven:3.9.11-eclipse-temurin-21@sha256:6fdc855a6ed81d288ca7ca37ac6ff5e9308b612485c0801d70b25a858c83d237 AS provider
WORKDIR /provider
COPY pom.xml ./
COPY src/ ./src/
RUN --mount=type=cache,target=/root/.m2 mvn -B -DskipTests package

FROM quay.io/keycloak/keycloak:26.8.2@sha256:3879c623248408de29a5303178b5816c77e8dfef3890c361f8c0bbeaa979ba3b
LABEL org.opencontainers.image.base.digest="sha256:3879c623248408de29a5303178b5816c77e8dfef3890c361f8c0bbeaa979ba3b"
COPY --from=provider --chown=keycloak:keycloak /provider/target/nexora-p0-email-otp.jar /opt/keycloak/providers/nexora-email-otp.jar
COPY --chown=keycloak:keycloak theme/ /opt/keycloak/themes/
RUN /opt/keycloak/bin/kc.sh build --db=postgres --health-enabled=true
