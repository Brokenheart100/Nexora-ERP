<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>WolverineFx.Grpc</id>
    <version>6.61.0</version>
    <authors>Jeremy D. Miller,Babu Annamalai,Jaedyn Tonee</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>logo.png</icon>
    <projectUrl>http://github.com/jasperfx/wolverine</projectUrl>
    <description>Code-first and proto-first gRPC service support for Wolverine, including gRPC message transport</description>
    <repository type="git" url="http://github.com/jasperfx/wolverine" branch="refs/heads/main" commit="29806dd8a8180d165878a6dcb8f096abd782dc84" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="WolverineFx" version="6.61.0" exclude="Build,Analyzers" />
        <dependency id="Google.Api.CommonProtos" version="2.16.0" exclude="Build,Analyzers" />
        <dependency id="Grpc.AspNetCore" version="2.76.0" exclude="Build,Analyzers" />
        <dependency id="Grpc.Net.Client" version="2.76.0" exclude="Build,Analyzers" />
        <dependency id="Grpc.Net.ClientFactory" version="2.76.0" exclude="Build,Analyzers" />
        <dependency id="Grpc.StatusProto" version="2.76.0" exclude="Build,Analyzers" />
        <dependency id="protobuf-net.Grpc" version="1.2.2" exclude="Build,Analyzers" />
        <dependency id="protobuf-net.Grpc.AspNetCore" version="1.2.2" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="WolverineFx" version="6.61.0" exclude="Build,Analyzers" />
        <dependency id="Google.Api.CommonProtos" version="2.16.0" exclude="Build,Analyzers" />
        <dependency id="Grpc.AspNetCore" version="2.76.0" exclude="Build,Analyzers" />
        <dependency id="Grpc.Net.Client" version="2.76.0" exclude="Build,Analyzers" />
        <dependency id="Grpc.Net.ClientFactory" version="2.76.0" exclude="Build,Analyzers" />
        <dependency id="Grpc.StatusProto" version="2.76.0" exclude="Build,Analyzers" />
        <dependency id="protobuf-net.Grpc" version="1.2.2" exclude="Build,Analyzers" />
        <dependency id="protobuf-net.Grpc.AspNetCore" version="1.2.2" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net10.0">
        <frameworkReference name="Microsoft.AspNetCore.App" />
      </group>
      <group targetFramework="net9.0">
        <frameworkReference name="Microsoft.AspNetCore.App" />
      </group>
    </frameworkReferences>
  </metadata>
</package>